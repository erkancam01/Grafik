//@version=5
indicator("Supertrend", overlay = true)
atrPeriod = input.int(10, "ATR periyodu", minval = 1)
factor    = input.float(3.0, "Çarpan", minval = 0.1, step = 0.1)
[st, dir] = ta.supertrend(factor, atrPeriod)
plot(dir < 0 ? st : na, "Yükseliş", color = color.green, style = plot.style_linebr, linewidth = 2)
plot(dir > 0 ? st : na, "Düşüş", color = color.red, style = plot.style_linebr, linewidth = 2)
plotshape(dir < 0 and dir[1] > 0, "Al", shape.labelup, location.belowbar, color.green, text = "Al", textcolor = color.white, size = size.tiny)
plotshape(dir > 0 and dir[1] < 0, "Sat", shape.labeldown, location.abovebar, color.red, text = "Sat", textcolor = color.white, size = size.tiny)
alertcondition(dir < 0 and dir[1] > 0, "Supertrend Al", "Supertrend yükselişe döndü")
alertcondition(dir > 0 and dir[1] < 0, "Supertrend Sat", "Supertrend düşüşe döndü")
