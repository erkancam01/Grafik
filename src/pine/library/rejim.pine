//@version=5
// Rejim (günlük) — coinin günlük rejimini (yükseliş / düşüş / yatay) arka plan rengiyle gösterir ve o rejimin
// kuralıyla Al / Sat / Çık sinyali verir. Aynı kurallarla backtest: "Rejim Strateji (günlük)"; bu gösterge stratejinin
// işlemlerini birebir izler: sinyal mumu kapanınca sonraki açılışta giriş, kâr al / zarar kes mum içinde (ikisi aynı
// mumdaysa açılışa yakın uç önce), en çok 20 mum, pozisyon varken yeni sinyal yok.
// Rejim: yükseliş = kapanış > EMA50 ve +DI > −DI ve ADX > 20; düşüş = kapanış < EMA50 ve −DI > +DI ve ADX > 20; yatay.
//   Yükseliş: UT Bot (2) "Sat" → AL (kâr al 0,5 / zarar kes 2 × ATR14). Düşüş: RSI14 < 30 → AL, > 70 → SAT
//   (1 / 2,5 × ATR14). Yatay: UT Bot (3) "Al" → AL (1,5 / 3 × ATR14).
// Kurallar 2020-2026 verisinde ileriye doğru yürüyen seçimle bulundu (README); 2026'nın ilk yarısında zarar etti.
indicator("Rejim (günlük)", shorttitle = "Rejim", overlay = true)

adxMin  = input.float(20, "ADX eşiği", minval = 0, group = "Rejim", tooltip = "ADX bu değerin üstündeyse trend var sayılır")
emaLen  = input.int(50, "Rejim EMA", minval = 1, group = "Rejim")
upA     = input.float(2, "Yükseliş: UT Bot anahtar değeri", step = 0.5, group = "Yükseliş: UT Bot 'Sat' → al")
upTp    = input.float(0.5, "Yükseliş: kâr al (ATR katı)", minval = 0.1, step = 0.25, group = "Yükseliş: UT Bot 'Sat' → al")
upSl    = input.float(2, "Yükseliş: zarar kes (ATR katı)", minval = 0.1, step = 0.25, group = "Yükseliş: UT Bot 'Sat' → al")
dnLo    = input.float(30, "Düşüş: RSI altı → al", minval = 0, maxval = 100, group = "Düşüş: RSI aşırılığı → dönüş")
dnHi    = input.float(70, "Düşüş: RSI üstü → sat", minval = 0, maxval = 100, group = "Düşüş: RSI aşırılığı → dönüş")
dnTp    = input.float(1, "Düşüş: kâr al (ATR katı)", minval = 0.1, step = 0.25, group = "Düşüş: RSI aşırılığı → dönüş")
dnSl    = input.float(2.5, "Düşüş: zarar kes (ATR katı)", minval = 0.1, step = 0.25, group = "Düşüş: RSI aşırılığı → dönüş")
sdA     = input.float(3, "Yatay: UT Bot anahtar değeri", step = 0.5, group = "Yatay: UT Bot 'Al' → al")
sdTp    = input.float(1.5, "Yatay: kâr al (ATR katı)", minval = 0.1, step = 0.25, group = "Yatay: UT Bot 'Al' → al")
sdSl    = input.float(3, "Yatay: zarar kes (ATR katı)", minval = 0.1, step = 0.25, group = "Yatay: UT Bot 'Al' → al")
upOn    = input.bool(true, "Yükselişte işlem aç", group = "Genel")
dnOn    = input.bool(true, "Düşüşte işlem aç", group = "Genel", tooltip = "2026'nın ilk yarısındaki zarar bu rejimden geldi")
sdOn    = input.bool(true, "Yatayda işlem aç", group = "Genel", tooltip = "İleriye yürüyen testte en zayıf rejim")
yon     = input.string("Her ikisi", "İşlem yönü", options = ["Her ikisi", "Yalnız long", "Yalnız short"], group = "Genel")
maxBars = input.int(20, "En uzun süre (mum, 0 = sınırsız)", minval = 0, group = "Genel", tooltip = "Günlük grafikte 20 mum = 20 gün")

atr14 = ta.atr(14)
atr10 = ta.atr(10)
rsi14 = ta.rsi(close, 14)
ema   = ta.ema(close, emaLen)
[diP, diM, adx] = ta.dmi(14, 14)
ready = not na(adx) and not na(ema) and not na(diP) and not na(diM)
rej = not ready ? 0 : close > ema and diP > diM and adx > adxMin ? 1 : close < ema and diM > diP and adx > adxMin ? -1 : 2

n2 = upA * atr10
t2 = 0.0
p2 = nz(t2[1], 0)
t2 := close > p2 and close[1] > p2 ? math.max(p2, close - n2) : close < p2 and close[1] < p2 ? math.min(p2, close + n2) : close > p2 ? close - n2 : close + n2
utSell2 = close < t2 and ta.crossover(t2, close)
n3 = sdA * atr10
t3 = 0.0
p3 = nz(t3[1], 0)
t3 := close > p3 and close[1] > p3 ? math.max(p3, close - n3) : close < p3 and close[1] < p3 ? math.min(p3, close + n3) : close > p3 ? close - n3 : close + n3
utBuy3 = close > t3 and ta.crossover(close, t3)

sigL = rej == 1 ? upOn and utSell2 : rej == -1 ? dnOn and rsi14 < dnLo : rej == 2 ? sdOn and utBuy3 : false
sigS = rej == -1 and dnOn and rsi14 > dnHi
tpK  = rej == 1 ? upTp : rej == -1 ? dnTp : sdTp
slK  = rej == 1 ? upSl : rej == -1 ? dnSl : sdSl

// Durum makinesi (stratejideki dolum kurallarıyla aynı): 0 boş, ±1 pozisyon; bekleyen giriş sonraki açılışta dolar
var int   pos       = 0
var int   pend      = 0
var bool  pendClose = false
var float tpD       = na
var float slD       = na
var float tpL       = na
var float slL       = na
var int   entryBar  = na
enterL  = false
enterS  = false
exitNow = false

// 1) Mum başı: süre çıkışı açılışta; bekleyen giriş açılışta
if pendClose and pos != 0
    exitNow := true
    pos := 0
pendClose := false
if pend != 0
    pos := pend
    tpL := open + pend * tpD
    slL := open - pend * slD
    entryBar := bar_index
    enterL := pend > 0
    enterS := pend < 0
    pend := 0

// 2) Mum içi: açılışta aşılmışsa açılıştan; ikisi de mum içindeyse açılışa yakın uç önce (strateji motoru gibi)
if pos != 0
    gapSl = pos > 0 ? open <= slL : open >= slL
    gapTp = pos > 0 ? open >= tpL : open <= tpL
    hitTp = pos > 0 ? high >= tpL : low <= tpL
    hitSl = pos > 0 ? low <= slL : high >= slL
    if gapSl or gapTp or hitTp or hitSl
        exitNow := true
        pos := 0

// 3) Mum kapanışı: süre sınırı, yeni sinyal
if pos != 0 and maxBars > 0 and bar_index - entryBar + 1 >= maxBars
    pendClose := true
goLong  = pos == 0 and not na(atr14) and sigL and yon != "Yalnız short"
goShort = pos == 0 and not na(atr14) and sigS and yon != "Yalnız long"
if goLong or goShort
    pend := goLong ? 1 : -1
    tpD := tpK * atr14
    slD := slK * atr14

bgcolor(rej == 1 ? color.new(color.green, 90) : rej == -1 ? color.new(color.red, 90) : rej == 2 ? color.new(color.gray, 92) : na, title = "Rejim")
plot(pos != 0 or exitNow ? tpL : na, "Kâr al", color = color.green, style = plot.style_linebr)
plot(pos != 0 or exitNow ? slL : na, "Zarar kes", color = color.red, style = plot.style_linebr)
plotshape(enterL, "Al", shape.labelup, location.belowbar, color.green, text = "Al", textcolor = color.white, size = size.tiny)
plotshape(enterS, "Sat", shape.labeldown, location.abovebar, color.red, text = "Sat", textcolor = color.white, size = size.tiny)
plotshape(exitNow, "Çık", shape.xcross, location.abovebar, color.gray, text = "Çık", textcolor = color.gray, size = size.tiny)
alertcondition(goLong, "Rejim Long", "Rejim: long sinyali (sonraki mumda giriş)")
alertcondition(goShort, "Rejim Short", "Rejim: short sinyali (sonraki mumda giriş)")
alertcondition(exitNow, "Rejim Çıkış", "Rejim: kâr al / zarar kes / süre çıkışı")
alertcondition(rej != rej[1] and rej != 0, "Rejim değişti", "Rejim değişti (yükseliş / düşüş / yatay)")
