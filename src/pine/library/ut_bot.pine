//@version=5
// UT Bot Alerts — ATR iz süren stop kesişimleri (Heikin Ashi seçeneğiyle). TradingView'daki aynı adlı
// göstergenin mantığıyla aynıdır: fiyat ATR izini yukarı keserse Al, aşağı keserse Sat.
indicator("UT Bot Alerts", overlay = true)

a = input.float(1, "Hassasiyet (anahtar değer)", step = 0.5)
c = input.int(10, "ATR periyodu", minval = 1)
h = input.bool(false, "Heikin Ashi mumlarından sinyal")

xATR  = ta.atr(c)
nLoss = a * xATR
src = h ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close, lookahead = barmerge.lookahead_off) : close

trail = 0.0
prevTrail = nz(trail[1], 0)
trail := if src > prevTrail and src[1] > prevTrail
    math.max(prevTrail, src - nLoss)
else if src < prevTrail and src[1] < prevTrail
    math.min(prevTrail, src + nLoss)
else if src > prevTrail
    src - nLoss
else
    src + nLoss

pos = 0
pos := src[1] < prevTrail and src > prevTrail ? 1 : src[1] > prevTrail and src < prevTrail ? -1 : nz(pos[1], 0)

emaSrc = ta.ema(src, 1)
above  = ta.crossover(emaSrc, trail)
below  = ta.crossover(trail, emaSrc)
buy    = src > trail and above
sell   = src < trail and below

plot(trail, "İz süren stop", color = pos == 1 ? color.green : pos == -1 ? color.red : color.blue, display = display.none)
plotshape(buy, "Al", shape.labelup, location.belowbar, color.green, text = "Al", textcolor = color.white, size = size.tiny)
plotshape(sell, "Sat", shape.labeldown, location.abovebar, color.red, text = "Sat", textcolor = color.white, size = size.tiny)
barcolor(src > trail ? color.green : src < trail ? color.red : na)

alertcondition(buy, "UT Long", "UT Long")
alertcondition(sell, "UT Short", "UT Short")
