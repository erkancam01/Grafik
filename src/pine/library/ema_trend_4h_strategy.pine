//@version=6
// EMA Trend 4s Strateji — botun sistemiyle (4s EMA20/EMA100) al-sat testi.
// 4 saatlik mum KAPANDIĞINDA EMA20 > EMA100 → long, EMA20 < EMA100 → short; emir sonraki mumun açılışında dolar
// (bot da sinyali 4s kapanışında görür, sonraki mumda girer). Ters sinyalde ters yöne geçilir.
// Koruyucu stop: giriş fiyatı ± 3 × ATR14 (son kapanmış 4s mumu). Stop yiyen işleme aynı sinyal sürerken yeniden
// girilmez. Grafik 4 saat ya da daha küçük zaman diliminde olmalı.
// Not: bot 15 coinde oynaklığa göre küçük boyutlarla işlem yapar; burada varsayılan boyut özsermayenin %100'ü
// (Ayarlar → Strateji özellikleri). Fonlama (funding) ücreti hesaba katılmaz.
strategy("EMA Trend 4s Strateji (bot sistemi)", shorttitle = "EMA Trend 4s S", overlay = true, initial_capital = 1000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.05)

tf       = input.timeframe("240", "Sinyal zaman dilimi")
fastLen  = input.int(20, "Hızlı EMA", minval = 1)
slowLen  = input.int(100, "Yavaş EMA", minval = 2)
atrLen   = input.int(14, "ATR uzunluğu", minval = 1)
stopMult = input.float(3.0, "Stop (ATR katı)", minval = 0.5, step = 0.5)
showEma  = input.bool(true, "EMA çizgilerini göster")

// 4s mumunun kapanış değerleri: 4s mumu kapandığı (grafik) mumda güncellenir, bakış-ileri yok
[fastH, slowH, atrH] = request.security(syminfo.tickerid, tf, [ta.ema(close, fastLen), ta.ema(close, slowLen), ta.atr(atrLen)], lookahead = barmerge.lookahead_off)

state   = fastH > slowH ? 1 : fastH < slowH ? -1 : 0
changed = state != nz(state[1], state)

var float atrE = na
if changed and state == 1 and not na(atrH)
    atrE := atrH
    strategy.entry("Long", strategy.long)
    strategy.exit("Stop L", "Long", loss = stopMult * atrH / syminfo.mintick)
else if changed and state == -1 and not na(atrH)
    atrE := atrH
    strategy.entry("Short", strategy.short)
    strategy.exit("Stop S", "Short", loss = stopMult * atrH / syminfo.mintick)
else if changed and state == 0
    strategy.close_all()

stopLvl = strategy.position_size > 0 ? strategy.position_avg_price - stopMult * atrE : strategy.position_size < 0 ? strategy.position_avg_price + stopMult * atrE : na
plot(showEma ? fastH : na, "EMA hızlı (4s)", color = color.orange, linewidth = 2)
plot(showEma ? slowH : na, "EMA yavaş (4s)", color = color.blue, linewidth = 2)
plot(stopLvl, "Stop", color = color.red, style = plot.style_linebr)
