{
  "name": "grafik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TradingView benzeri grafik + Pine Script indikatörleri (tarayıcıda, Binance verisi)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "bt:import": "python3 tools/backtest/import_market_data.py",
    "bt:sweep": "node --import jiti/register tools/backtest/sweep.ts",
    "bt:final": "node --import jiti/register tools/backtest/final.ts"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
