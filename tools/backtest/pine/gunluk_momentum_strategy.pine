//@version=5
// Günlük Momentum Strateji — 1 günlük grafikte güçlü mumdan sonra aynı yönde kısa hedefli işlem.
// Kural (2020-2022 verisinin taramasından; bkz. tools/backtest/long_study.py, protocol.ts L_STUDY): mum gövdesi
// önceki mumun ATR14 değerinin 1,5 katını aşarsa mum yönünde, sonraki mumun açılışında girilir. Kâr al 1 × ATR14,
// zarar kes 3 × ATR14 (sinyal mumundaki ATR), en çok 20 mum (gün). Pozisyon varken yeni giriş yapılmaz.
// Kazanma oranı yüksektir, ortalama kazanç ortalama zarardan küçüktür.
// Varsayılan: 1000 USDT, her işlemde özsermayenin %100'ü, komisyon %0,05 (Binance vadeli piyasa emri).
// Hepsi Ayarlar → Strateji özellikleri'nden değiştirilebilir. Grafik 1 gün olmalı.
strategy("Günlük Momentum Strateji", shorttitle = "Günlük Momentum S", overlay = true, initial_capital = 1000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.05)

k       = input.float(1.5, "Güçlü mum eşiği (gövde / ATR)", minval = 0.5, step = 0.25, group = "Giriş", tooltip = "Mum gövdesi, önceki mumun ATR14 değerinin bu katını aşarsa sinyal")
yon     = input.string("Her ikisi", "İşlem yönü", options = ["Her ikisi", "Yalnız long", "Yalnız short"], group = "Giriş")
tpK     = input.float(1, "Kâr al (ATR katı)", minval = 0.1, step = 0.25, group = "Çıkış")
slK     = input.float(3, "Zarar kes (ATR katı)", minval = 0.1, step = 0.25, group = "Çıkış")
maxBars = input.int(20, "En uzun süre (mum, 0 = sınırsız)", minval = 0, group = "Çıkış", tooltip = "Günlük grafikte 20 mum = 20 gün")

atr14 = ta.atr(14)
body  = close - open
dir   = math.abs(body) > k * atr14[1] ? math.sign(body) : 0

flat    = strategy.position_size == 0
goLong  = flat and not na(atr14[1]) and dir > 0 and yon != "Yalnız short"
goShort = flat and not na(atr14[1]) and dir < 0 and yon != "Yalnız long"

var float atrE = na
if goLong
    atrE := atr14
    strategy.entry("Long", strategy.long)
    strategy.exit("Çıkış L", "Long", profit = tpK * atr14 / syminfo.mintick, loss = slK * atr14 / syminfo.mintick, comment_profit = "TP", comment_loss = "SL")
if goShort
    atrE := atr14
    strategy.entry("Short", strategy.short)
    strategy.exit("Çıkış S", "Short", profit = tpK * atr14 / syminfo.mintick, loss = slK * atr14 / syminfo.mintick, comment_profit = "TP", comment_loss = "SL")

pos = strategy.position_size
if pos != 0 and maxBars > 0 and bar_index - strategy.opentrades.entry_bar_index(0) + 1 >= maxBars
    strategy.close_all(comment = "Süre")

ep = strategy.position_avg_price
plot(pos > 0 ? ep + tpK * atrE : pos < 0 ? ep - tpK * atrE : na, "Kâr al", color = color.green, style = plot.style_linebr)
plot(pos > 0 ? ep - slK * atrE : pos < 0 ? ep + slK * atrE : na, "Zarar kes", color = color.red, style = plot.style_linebr)
plot(atrE, "ATR giriş", display = display.none)
barcolor(dir > 0 ? color.lime : dir < 0 ? color.fuchsia : na)
